{{- define "cardsV2" -}}
{
  "card": {
    "sections": [
      {
        "header": {{ json (printf "<b>(%s) %s - %s</b>" (.Labels.severity | toUpper) (.Labels.alertname | Title) (.Status | Title)) }},
        "widgets": [
          {{- range $i, $pair := .Annotations.SortedPairs -}}
          {{- if ne $i 0 -}},{{- end -}}
          {
            "decoratedText": {
              "text": {{ json (printf "%s: %s" ($pair.Name | Title) $pair.Value) }}
            }
          }
          {{- end -}}
        ]
      }
    ]
  }
}
{{- end -}}
