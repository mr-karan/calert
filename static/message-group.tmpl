{{ .AlertName }} - {{ .Status | Title }} ({{ .FiringCount }} firing / {{ .ResolvedCount }} resolved)
{{- define "cardsV2" -}}
{
  "cardId": {{ json .TrackingKey }},
  "card": {
    "header": {
      "title": {{ if eq .Status "resolved" }}{{ json (printf "🟢 %s" .AlertName) }}{{ else if eq .Labels.severity "critical" }}{{ json (printf "🔴 %s" .AlertName) }}{{ else if eq .Labels.severity "critical-daytime" }}{{ json (printf "🟣 %s" .AlertName) }}{{ else if eq .Labels.severity "warning" }}{{ json (printf "🟡 %s" .AlertName) }}{{ else }}{{ json (printf "🔵 %s" .AlertName) }}{{ end }},
      "subtitle": {{ json (printf "%d firing / %d resolved" .FiringCount .ResolvedCount) }}
    },
    "sections": [
      {
        "widgets": [
          {
            "buttonList": {
              "buttons": [
                {{- if .GeneratorURL -}}
                { "text": "Prometheus", "onClick": { "openLink": { "url": {{ json .GeneratorURL }} } } }
                {{- end -}}
                {{- if .Annotations.runbook_url -}}
                {{- if .GeneratorURL }},{{ end -}}
                { "text": "Handbook", "onClick": { "openLink": { "url": {{ json .Annotations.runbook_url }} } } }
                {{- end -}}
              ]
            }
          }
        ]
      }
      {{- range .Alerts -}},
      {
        "header": {{ if eq .Status "firing" }}{{ json (printf "🔥 FIRING %s" (.Labels.instance | Default .Fingerprint)) }}{{ else }}{{ json (printf "✅ RESOLVED %s" (.Labels.instance | Default .Fingerprint)) }}{{ end }},
        "collapsible": true,
        "uncollapsibleWidgetsCount": 1,
        "widgets": [
          { "decoratedText": { "text": {{ json (printf "<b>%s</b> since %s" (.Status | toUpper) (.StartsAt.UTC.Format "2006-01-02 15:04 MST")) }} } }
          {{- range .Labels.SortedPairs -}},
          { "decoratedText": { "topLabel": {{ json .Name }}, "text": {{ json .Value }} } }
          {{- end -}}
          {{- range .Annotations.SortedPairs -}},
          { "decoratedText": { "topLabel": {{ json .Name }}, "text": {{ json .Value }} } }
          {{- end -}}
        ]
      }
      {{- end -}}
      {{- if gt .Overflow.Count 0 -}},
      {
        "widgets": [
          { "textParagraph": { "text": {{ json (printf "… and %d more instances (%d firing / %d resolved)" .Overflow.Count .Overflow.Firing .Overflow.Resolved) }} } }
        ]
      }
      {{- end -}}
      {{- if gt .TruncatedAlerts 0 -}},
      {
        "widgets": [
          { "textParagraph": { "text": {{ json (printf "%d additional alerts were truncated by Alertmanager" .TruncatedAlerts) }} } }
        ]
      }
      {{- end -}}
    ]
  }
}
{{- end -}}
